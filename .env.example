# KRISHIWEB ENVIRONMENT CONFIGURATION

# Port for the Node.js backend server
PORT=3000

# Open Government Data (data.gov.in) API Key for AGMARKNET Mandi Price Data
# Default test key is preconfigured. For production, register at https://data.gov.in
DATA_GOV_API_KEY=YOUR_DATA_GOV_API_KEY

# Google Maps Routes API Key for Live Traffic & Road Routing
# When omitted, KrishiWeb uses the documented commercial transit road model (1.28x winding factor, 42 km/h)
GOOGLE_MAPS_API_KEY=
